          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_MFA_CODE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "MFA_ALREADY_ENROLLED — or enrolment was not started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "string",
                  "description": "Seconds to wait before retrying"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error (standard error envelope)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/mfa/verify": {
      "post": {
        "operationId": "verifyMfa",
        "summary": "Second login step for platform accounts (uses the MFA challenge cookie set by login)",
        "tags": [
          "public"
        ],
        "x-audience": "public",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyMfaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "headers": {
              "Set-Cookie": {
                "required": true,
                "description": "Session cookies: __Secure-ak_at, __Secure-ak_rt and __Secure-ak_csrf (HttpOnly except the CSRF cookie)",
                "schema": {
                  "type": "string",
                  "description": "Session cookies: __Secure-ak_at, __Secure-ak_rt and __Secure-ak_csrf (HttpOnly except the CSRF cookie)"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_MFA_CODE (try again; 5 attempts per challenge) or INVALID_OR_EXPIRED_TOKEN (sign in again)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "string",
                  "description": "Seconds to wait before retrying"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error (standard error envelope)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "$ref": "#/components/schemas/Email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "audience": {
            "$ref": "#/components/schemas/WebAudience"
          }
        },
        "required": [
          "email",
          "password",
          "audience"
        ]
      },
      "Email": {
        "type": "string",
        "maxLength": 254,
        "format": "email",
        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
        "example": "owner@example.com"
      },
      "WebAudience": {
        "type": "string",
        "enum": [
          "platform",
          "merchant"
        ]
      },
      "SignupRequest": {
        "type": "object",
        "properties": {
          "email": {
            "$ref": "#/components/schemas/Email"
          },
          "password": {
            "$ref": "#/components/schemas/NewPassword"
          },
          "businessName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          }
        },
        "required": [
          "email",
          "password",
          "businessName"
        ]
      },
      "NewPassword": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "description": "12-128 characters, no composition rules; very common passwords are refused (422 WEAK_PASSWORD, D10)"
      },
      "VerifyEmailRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "token"
        ]
      },
      "ResendVerificationRequest": {
        "type": "object",
        "properties": {
          "email": {
            "$ref": "#/components/schemas/Email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "$ref": "#/components/schemas/Email"
          }
        },
        "required": [
          "email"
        ]
      },
      "SetPasswordRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "password": {
            "$ref": "#/components/schemas/NewPassword"
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "newPassword": {
            "$ref": "#/components/schemas/NewPassword"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "ConfirmTotpRequest": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/TotpCode"
          }
        },
        "required": [
          "code"
        ]
      },
      "TotpCode": {
        "type": "string",
        "pattern": "^\\d{6}$"
      },
      "VerifyMfaRequest": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/TotpCode"
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "recoveryCode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "recoveryCode"
            ],
            "additionalProperties": false
          }
        ],
        "description": "Either the current authenticator code or one recovery code"
      },
      "AmountMinor": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,18})$",
        "description": "Non-negative amount in minor units (kobo) as a decimal digit string",
        "example": "150000"
      },
      "Currency": {
        "type": "string",
        "const": "NGN",
        "description": "ISO 4217 currency code. Only NGN is accepted."
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string",
                "description": "Human-readable; never contains secrets"
              },
              "details": {},
              "requestId": {
                "type": "string",
                "description": "Echoed in the x-request-id response header"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "description": "Every error response uses this envelope"
      },
      "ErrorCode": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "example": "NOT_FOUND"
      },
      "LoginResponse": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "authenticated"
              },
              "session": {
                "$ref": "#/components/schemas/Session"
              }
            },
            "required": [
              "status",
              "session"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "mfa_enrollment_required"
              },
              "session": {
                "$ref": "#/components/schemas/Session"
              }
            },
            "required": [
              "status",
              "session"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "mfa_required"
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          }
        ],
        "type": "object"
      },
      "Session": {
        "type": "object",
        "properties": {
          "identityId": {
            "$ref": "#/components/schemas/Id"
          },
          "audience": {
            "$ref": "#/components/schemas/SessionAudience"
          },
          "membershipId": {
            "$ref": "#/components/schemas/Id"
          },
          "merchantId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "full",
              "mfa_enrollment"
            ]
          }
        },
        "required": [
          "identityId",
          "audience",
          "membershipId",
          "merchantId",
          "scope"
        ],
        "additionalProperties": false,
        "description": "The signed-in session (no tokens: those are in HttpOnly cookies)"
      },
      "SessionAudience": {
        "type": "string",
        "enum": [
          "platform",
          "merchant",
          "agent"
        ]
      },
      "VerificationPending": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "verification_email_sent"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "description": "If the email can receive a verification link, one has been sent. Identical for every email."
      },
      "PasswordEmailPending": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "password_email_sent"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "description": "If the email has an account, a link has been sent to it. Identical for every email."
      },
      "TotpEnrollment": {
        "type": "object",
        "properties": {
          "otpauthUri": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^otpauth:\\/\\/totp\\/.*"
          },
          "secret": {
            "type": "string",
            "pattern": "^[A-Z2-7]+$"
          }
        },
        "required": [
          "otpauthUri",
          "secret"
        ],
        "additionalProperties": false,
        "description": "Shown once. Not stored by the client."
      },
      "TotpEnrolled": {
        "type": "object",
        "properties": {
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "recoveryCodes": {
            "minItems": 10,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "session",
          "recoveryCodes"
        ],
        "additionalProperties": false
      },
      "Id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
        "description": "UUIDv7 identifier",
        "example": "01900000-0000-7000-8000-00000000000a"
      },
      "Money": {
        "type": "object",
        "properties": {
          "amountMinor": {
            "$ref": "#/components/schemas/AmountMinor"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          }
        },
        "required": [
          "amountMinor",
          "currency"
        ],
        "additionalProperties": false,
        "description": "An amount of money",
        "example": {
          "amountMinor": "150000",
          "currency": "NGN"
        }
      }
    },
    "securitySchemes": {
      "cookieSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-ak_at",
        "description": "Web audiences (platform, merchant): HttpOnly access-token cookie (ADR-14 D7)"
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Echo of the __Secure-ak_csrf cookie, required on state-changing cookie requests"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Mobile audiences (agent, customer): EdDSA-signed access token (ADR-14 D6)"
      }
    }
  }
}
