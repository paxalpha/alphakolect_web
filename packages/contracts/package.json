{
  "name": "@alphakolect/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "API contracts only: zod schemas, the endpoint registry and API primitives (TARGET_ARCHITECTURE §17, RESTRUCTURING_MAP §1). No behaviour.",
  "type": "module",
  "exports": {
    ".": {
      "@alphakolect/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@alphakolect/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "openapi:generate": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "build": "pnpm client:generate && tsc -p tsconfig.build.json && pnpm consumer:typecheck",
    "typecheck": "pnpm client:generate && tsc --noEmit",
    "test": "pnpm client:generate && vitest run",
    "client:generate": "openapi-typescript openapi/v1.json --output src/generated/v1.ts",
    "consumer:typecheck": "tsc -p consumer/tsconfig.json"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@alphakolect/config": "workspace:*",
    "@types/node": "^24.13.6",
    "openapi-typescript": "7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod-openapi": "6.0.2"
  }
}
