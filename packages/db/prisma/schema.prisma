// AlphaKolect database schema — P1 foundation (RESTRUCTURING_MAP P1, TARGET_ARCHITECTURE §4, §7, §16, §19).
//
// Prisma is the application schema/migration authority; PostgreSQL enforces the security and
// accounting invariants (ADR-4). Everything Prisma cannot express lives in raw SQL migrations:
//   - util.uuid_v7() id generator
//   - ledger balance and immutability triggers
//   - row-level security policies
//   - per-table grants for alphakolect_app / alphakolect_readonly
//
// Conventions (§19): one Postgres schema per module; snake_case; UUIDv7 primary keys; timestamptz;
// money as bigint minor units (kobo) + char(3) currency (NGN only, ADR-11); every tenant-owned row has
// merchant_id NOT NULL; composite (merchant_id, id) foreign keys keep references inside one tenant.
//
// P1 deliberately contains only the tenant anchor, the ledger core and the audit log. No workflows.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // NodeNext ESM: generated files import each other with .js extensions
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["util", "identity", "tenancy", "customers", "savings", "loans", "investments", "payments", "ledger", "billing", "kyc", "support", "notifications", "documents", "audit", "jobs"]
}

// ── tenancy ─────────────────────────────────────────────────────────────────────────────────────

/// The tenant. Every tenant-owned row in every module references a merchant.
/// P1 holds only what row-level security and composite keys need; the tenancy module grows in P4.
model Merchant {
  id                 String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  name               String
  /// pending_verification | active | deactivated (P4.1, ADR-15 T6; CHECK in SQL)
  status             String    @default("pending_verification")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Set exactly when status = deactivated (platform super admin, with a reason).
  deactivatedAt      DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivationReason String?   @map("deactivation_reason")

  ledgers           Ledger[]
  accounts          Account[]
  journalEntries    JournalEntry[]
  journalLines      JournalLine[]
  balanceProjection BalanceProjection[]
  idempotencyRecords IdempotencyRecord[]
  auditEvents       AuditEvent[]
  memberships       MerchantMembership[]
  customers          Customer[]
  customerAssignments CustomerAssignment[]
  customerAppInvitations CustomerAppInvitation[]
  savingsPackages    SavingsPackage[]
  savingsEnrolments  SavingsEnrolment[]
  savingsCycles      SavingsCycle[]
  remittances        Remittance[]
  collections        Collection[]
  savingsMovements   SavingsMovement[]
  targetGoals        TargetGoal[]
  liveWallets        LiveWallet[]
  paymentReceipts    PaymentReceipt[]
  branches          Branch[]
  roles             Role[]
  invitations       Invitation[]

  /// P5.7: the platform list of businesses, newest first (chosen from recorded query plans)
  @@index([createdAt, id], map: "merchants_created_at_id_idx")
  @@map("merchants")
  @@schema("tenancy")
}

// ── ledger ──────────────────────────────────────────────────────────────────────────────────────

/// A business's books (one per business), or the platform's (TA-1: owner_kind 'platform', no business; one
/// platform ledger, a partial unique index). Reached only through definer functions (TA-3).
model Ledger {
  id         String   @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId String?  @unique @map("merchant_id") @db.Uuid
  ownerKind  String   @default("merchant") @map("owner_kind")
  currency   String   @default("NGN") @db.Char(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant       Merchant?      @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accounts       Account[]
  journalEntries JournalEntry[]
  paymentOrders PaymentOrder[]

  @@unique([merchantId, id])
  @@map("ledgers")
  @@schema("ledger")
}

/// Chart-of-accounts entry or per-subject sub-account (e.g. one savings account per customer). The system accounts
/// come from ledger.chart_template (P6, owner Q1). Unique by (ledger, code, subject), NULLS NOT DISTINCT (TA-5:
/// accounts_ledger_id_code_subject_key, in the migration).
model Account {
  id              String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId      String?   @map("merchant_id") @db.Uuid
  ledgerId        String   @map("ledger_id") @db.Uuid
  code            String
  name            String
  type            String
  parentAccountId String?  @map("parent_account_id") @db.Uuid
  /// What a sub-account belongs to (e.g. "customer"), with its id. Both null for plain accounts.
  subjectType     String?  @map("subject_type")
  subjectId       String?  @map("subject_id") @db.Uuid
  isSystem        Boolean   @default(false) @map("is_system")
  /// A posting may not take this account below zero (BR-7.4).
  nonNegative     Boolean   @default(false) @map("non_negative")
  status          String    @default("active")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant   Merchant?          @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ledger     Ledger?            @relation(fields: [merchantId, ledgerId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict)
  parent     Account?           @relation("AccountParent", fields: [merchantId, parentAccountId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict)
  children   Account[]          @relation("AccountParent")
  lines      JournalLine[]
  projection BalanceProjection?

  @@unique([merchantId, id])
  @@unique([ledgerId, code, subjectType, subjectId], map: "accounts_ledger_id_code_subject_key")
  @@map("accounts")
  @@schema("ledger")
}

/// Journal entry header. Immutable once written: corrections are reversing entries (BR-11.1).
model JournalEntry {
  id              String   @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId      String?  @map("merchant_id") @db.Uuid
  ledgerId        String   @map("ledger_id") @db.Uuid
  effectiveDate   DateTime @map("effective_date") @db.Date
  entryType       String   @map("entry_type")
  narrative       String
  sourceType      String?  @map("source_type")
  sourceId        String?  @map("source_id")
  idempotencyKey  String   @map("idempotency_key")
  reversesEntryId String?  @map("reverses_entry_id") @db.Uuid
  /// The identity that posted the entry (identity.identities).
  createdBy       String?  @map("created_by") @db.Uuid
  /// The posting template's version, for an entry posted by a template (entry_type is then its code).
  templateVersion Int?     @map("template_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant   Merchant?      @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ledger     Ledger?        @relation(fields: [merchantId, ledgerId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict)
  template   PostingTemplate? @relation(fields: [entryType, templateVersion], references: [code, version], onDelete: Restrict, onUpdate: Restrict, map: "journal_entries_template_fkey")
  reverses   JournalEntry?  @relation("EntryReversal", fields: [merchantId, reversesEntryId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict)
  reversedBy JournalEntry[] @relation("EntryReversal")
  creator    Identity?      @relation("JournalEntryCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines      JournalLine[]
  collectionsRecorded  Collection[]      @relation("CollectionRecordedEntry")
  collectionsConfirmed Collection[]      @relation("CollectionConfirmedEntry")
  collectionFees       Collection[]      @relation("CollectionFeeEntry")
  collectionsCancelled Collection[]      @relation("CollectionCancelEntry")
  savingsMovements     SavingsMovement[]
  providerTransactions ProviderTransaction[]
  receiptsReceived     PaymentReceipt[]  @relation("ReceiptReceivedEntry")
  receiptsClassified   PaymentReceipt[]  @relation("ReceiptClassifiedEntry")
  paymentOrders        PaymentOrder[]    @relation("PaymentOrderEntry")

  @@unique([merchantId, id])
  @@unique([merchantId, idempotencyKey])
  @@unique([ledgerId, idempotencyKey])
  @@index([ledgerId, effectiveDate])
  @@map("journal_entries")
  @@schema("ledger")
}

/// One side of a journal entry. INSERT-only; the entry must balance (Σdebits = Σcredits) at commit.
model JournalLine {
  id          String   @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId  String?  @map("merchant_id") @db.Uuid
  entryId     String   @map("entry_id") @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  side        String
  amountMinor BigInt   @map("amount_minor")
  currency    String   @db.Char(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant?     @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entry    JournalEntry? @relation(fields: [merchantId, entryId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict)
  account  Account?      @relation(fields: [merchantId, accountId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([merchantId, id])
  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
  @@schema("ledger")
}

/// Read model: current balance per account, updated in the same transaction as each posting (§7).
model BalanceProjection {
  accountId    String   @id @map("account_id") @db.Uuid
  merchantId   String?  @map("merchant_id") @db.Uuid
  balanceMinor BigInt   @default(0) @map("balance_minor")
  version      BigInt   @default(0)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account  Account?  @relation(fields: [merchantId, accountId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([merchantId, accountId])
  @@map("balance_projection")
  @@schema("ledger")
}

/// The chart every ledger opens with (P6, owner Q1), by kind of ledger. A row with a subject type is a control
/// account whose balance lives in one sub-account per customer or agent.
model ChartTemplate {
  ledgerKind  String  @map("ledger_kind")
  code        String
  name        String
  type        String
  nonNegative Boolean @map("non_negative")
  subjectType String? @map("subject_type")
  purpose     String

  @@id([ledgerKind, code])
  @@map("chart_template")
  @@schema("ledger")
}

/// The transaction mappings (P6 plan §4; owner Q2, Q3, Q5, Q6): each line a chart code, a side and, for a control
/// account, the subject; every line takes the posting's one amount.
model PostingTemplate {
  code        String
  /// A version never changes once written; a new mapping is a new version (P6 rev 3). At most one version of a code
  /// is active (posting_templates_one_active, a partial unique index in the migration).
  version     Int            @default(1)
  ledgerKind  String         @map("ledger_kind")
  description String
  lines       Json
  status      String         @default("active")
  entries     JournalEntry[]

  @@id([code, version])
  @@map("posting_templates")
  @@schema("ledger")
}

// ── audit ───────────────────────────────────────────────────────────────────────────────────────

/// Append-only audit log (§16). merchant_id is null for events outside any tenant (e.g. a failed
/// platform login). summary must never contain secrets.
model AuditEvent {
  id                String   @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  occurredAt        DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  merchantId        String?  @map("merchant_id") @db.Uuid
  actorIdentityId   String?  @map("actor_identity_id") @db.Uuid
  actorAudience     String?  @map("actor_audience")
  actorMembershipId String?  @map("actor_membership_id") @db.Uuid
  action            String
  targetType        String?  @map("target_type")
  targetId          String?  @map("target_id")
  outcome           String
  ip                String?
  userAgent         String?  @map("user_agent")
  requestId         String?  @map("request_id")
  summary           Json     @default("{}")

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor    Identity? @relation("AuditActor", fields: [actorIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// The activity-record reads' indexes (P5.8, 20261019000100_audit_reads; measured in
  /// docs/architecture/evidence/p5-audit-read-indexes).
  @@index([merchantId, occurredAt, id], map: "audit_events_merchant_id_occurred_at_id_idx")
  @@index([actorIdentityId, occurredAt, id], map: "audit_events_actor_identity_id_occurred_at_id_idx")
  @@index([merchantId, actorIdentityId, occurredAt, id], map: "audit_events_merchant_id_actor_identity_id_occurred_at_id_idx")
  @@index([action, occurredAt])
  /// P5.8 (Part 2): the purge pages by it, and the audit reads use it too.
  @@index([occurredAt, id], map: "audit_events_occurred_at_id_idx")
  @@map("audit_events")
  @@schema("audit")
}

/// P5.3a (ADR-16, plan §8.1): the closed catalog of (identifier, outcome) pairs with their class, writer pattern and
/// summary allowlist. A BEFORE INSERT trigger on audit_events validates every row against it (SQL). Entries are never
/// deleted (retired instead). App SELECT only; nothing for the reporting role.
model AuditEventCatalogEntry {
  identifier        String
  /// success | failure | denied
  outcome           String
  /// atomic | best_effort | sensitive_read
  class             String
  /// A | B for atomic pairs; null otherwise
  writerPattern     String?                  @map("writer_pattern")
  /// field → { type: string | integer | boolean, max?: characters, nullable?: true }
  summaryAllowlist  Json                     @default("{}") @map("summary_allowlist")
  /// NULL for every P5 pair: the D9 retention applies
  retentionOverride Unsupported("interval")? @map("retention_override")
  /// active | retired
  status            String                   @default("active")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([identifier, outcome])
  @@map("event_catalog")
  @@schema("audit")
}

// ── the retention purge (P5.8 step (a), Part 2; P5 plan §8.6) ───────────────────────────────────────────────────
// Written only by the operator-only purge functions (owned by the migrator); nothing granted to the app or the
// reporting role. CHECKs, the one-row key and the partial unique indexes live in SQL.

/// The run-wide reservation: exactly one row.
model PurgeReservation {
  id         Boolean   @id @default(true)
  runId      String?   @map("run_id") @db.Uuid
  pAsOf      DateTime? @map("p_as_of") @db.Timestamptz(6)
  reservedAt DateTime? @map("reserved_at") @db.Timestamptz(6)
  renewedAt  DateTime? @map("renewed_at") @db.Timestamptz(6)

  @@map("purge_reservation")
  @@schema("audit")
}

/// One row per purge run, never deleted: its kind, its read position, what it deleted.
model PurgeRun {
  runId               String    @id @map("run_id") @db.Uuid
  /// plain | export
  kind                String
  pAsOf               DateTime  @map("p_as_of") @db.Timestamptz(6)
  reservedAt          DateTime  @map("reserved_at") @db.Timestamptz(6)
  takenOverRun        String?   @map("taken_over_run") @db.Uuid
  scanAfterOccurredAt DateTime? @map("scan_after_occurred_at") @db.Timestamptz(6)
  scanAfterId         String?   @map("scan_after_id") @db.Uuid
  exhaustedAt         DateTime? @map("exhausted_at") @db.Timestamptz(6)
  rowsDeleted         Int       @default(0) @map("rows_deleted")
  releasedAt          DateTime? @map("released_at") @db.Timestamptz(6)
  completed           Boolean?

  @@map("purge_runs")
  @@schema("audit")
}

/// The manifest's pages: what purge_candidates handed out.
model PurgeRunPage {
  runId        String    @map("run_id") @db.Uuid
  pageNo       Int       @map("page_no")
  rowCount     Int       @map("row_count")
  digest       String
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(6)
  deletedCount Int?      @map("deleted_count")

  @@id([runId, pageNo])
  @@map("purge_run_pages")
  @@schema("audit")
}

/// The manifest's events: each page's event ids, in order.
model PurgeRunEvent {
  runId   String @map("run_id") @db.Uuid
  pageNo  Int    @map("page_no")
  ordinal Int
  eventId String @map("event_id") @db.Uuid

  @@id([runId, pageNo, ordinal])
  @@index([eventId], map: "purge_run_events_event_id_idx")
  @@map("purge_run_events")
  @@schema("audit")
}

/// The owner's requests for a copy of the entries due for deletion (one open at most).
model PurgeReportRequest {
  id          String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  note        String
  /// open | satisfied | cancelled
  state       String    @default("open")
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
  closeNote   String?   @map("close_note")

  reports PurgeReport[]

  @@map("purge_report_requests")
  @@schema("audit")
}

/// One row per export run that began: recorded before its file exists.
model PurgeExport {
  runId              String    @id @map("run_id") @db.Uuid
  directory          String
  writerHostId       String    @map("writer_host_id")
  writerLockKey      String    @map("writer_lock_key")
  startedAt          DateTime  @map("started_at") @db.Timestamptz(6)
  artifactRecordedAt DateTime? @map("artifact_recorded_at") @db.Timestamptz(6)
  /// confirmed | discarded
  outcome            String?
  endedAt            DateTime? @map("ended_at") @db.Timestamptz(6)
  note               String?
  lost               Boolean   @default(false)

  @@map("purge_exports")
  @@schema("audit")
}

/// A confirmed copy for the owner: active (its rows held) until delivered, withdrawn or lost.
model PurgeReport {
  id                  String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  requestId           String    @map("request_id") @db.Uuid
  runId               String    @unique @map("run_id") @db.Uuid
  pAsOf               DateTime  @map("p_as_of") @db.Timestamptz(6)
  confirmedAt         DateTime  @map("confirmed_at") @db.Timestamptz(6)
  rowCount            Int       @map("row_count")
  pageCount           Int       @map("page_count")
  manifestDigest      String    @map("manifest_digest")
  fileSha256          String    @map("file_sha256")
  fileLocation        String    @map("file_location")
  deliveredHandoverId String?   @map("delivered_handover_id") @db.Uuid
  deliveredAt         DateTime? @map("delivered_at") @db.Timestamptz(6)
  receiptReference    String?   @map("receipt_reference")
  deliveryNote        String?   @map("delivery_note")
  withdrawnAt         DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  lostAt              DateTime? @map("lost_at") @db.Timestamptz(6)
  lossNote            String?   @map("loss_note")
  copyDestroyedAt     DateTime? @map("copy_destroyed_at") @db.Timestamptz(6)
  /// automatic | attested | lost
  destroyMode         String?   @map("destroy_mode")
  destroyNote         String?   @map("destroy_note")
  lostHost            Boolean   @default(false) @map("lost_host")

  request           PurgeReportRequest    @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deliveredHandover PurgeReportHandover?  @relation("DeliveredHandover", fields: [deliveredHandoverId, id], references: [id, reportId], onDelete: Restrict, onUpdate: Restrict, map: "purge_reports_delivered_handover_fkey")
  handovers         PurgeReportHandover[] @relation("ReportHandovers")

  @@map("purge_reports")
  @@schema("audit")
}

/// One row per handover attempt of a report onto a stick (at most one live per report).
model PurgeReportHandover {
  id             String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  reportId       String    @map("report_id") @db.Uuid
  startedAt      DateTime  @map("started_at") @db.Timestamptz(6)
  medium         String
  writtenAt      DateTime? @map("written_at") @db.Timestamptz(6)
  writeDiskseq   String?   @map("write_diskseq")
  verifyDiskseq  String?   @map("verify_diskseq")
  ejectAttested  Boolean   @default(false) @map("eject_attested")
  /// recorded | abandoned | superseded
  outcome        String?
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(6)
  mediumSha256   String?   @map("medium_sha256")
  note           String?
  fateAttestedAt DateTime? @map("fate_attested_at") @db.Timestamptz(6)
  fateNote       String?   @map("fate_note")

  report      PurgeReport   @relation("ReportHandovers", fields: [reportId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deliveredIn PurgeReport[] @relation("DeliveredHandover")

  @@unique([id, reportId])
  @@map("purge_report_handovers")
  @@schema("audit")
}

// ── identity (P3, TARGET_ARCHITECTURE §3, ADR-14) ───────────────────────────────────────────────
// The app role has NO table privileges here: it reaches identity data only through SECURITY DEFINER
// functions (ADR-14 D4). Tokens are stored only as SHA-256 hashes; passwords only as argon2id hashes.

/// One per person (§3.1). Email is the only login identifier for now (D11), stored lowercase.
model Identity {
  id                String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  email             String    @unique
  status            String    @default("active")
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(6)
  /// argon2id PHC string; null until a password is set (e.g. a bootstrapped super admin, D9).
  passwordHash      String?   @map("password_hash")
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  platformMembership            PlatformMembership?
  merchantMemberships           MerchantMembership[]
  sessions                      Session[]
  liveWalletsRequested LiveWallet[] @relation("LiveWalletRequestedBy")
  transactionsResolved ProviderTransaction[] @relation("ProviderTransactionResolvedBy")
  findingsResolved     ReconciliationFinding[] @relation("FindingResolvedBy")
  oneTimeTokens                 OneTimeToken[]
  mfaChallenges                 MfaChallenge[]
  membershipSelectionChallenges MembershipSelectionChallenge[]
  invitations                   Invitation[]
  totpCredential                TotpCredential?
  recoveryCodes                 RecoveryCode[]
  journalEntries                JournalEntry[]                 @relation("JournalEntryCreator")
  idempotencyRecords            IdempotencyRecord[]
  auditEvents                   AuditEvent[]                   @relation("AuditActor")
  customers                     Customer[]
  customerAppInvitations        CustomerAppInvitation[]

  @@map("identities")
  @@schema("identity")
}

/// Platform audience membership (§3.1): super admin now; support, verification and finance later (P4/P5).
model PlatformMembership {
  id            String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  identityId    String    @unique @map("identity_id") @db.Uuid
  role          String
  status        String    @default("active")
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  identity      Identity                  @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessions      Session[]
  mfaChallenges MfaChallenge[]
  grants        PlatformMembershipGrant[]

  @@map("platform_memberships")
  @@schema("identity")
}

/// P5.1 (ADR-16): the permission catalog — the only authority for identifiers, scope and grantability. CHECKs, the
/// protection trigger (identifier, scope and grantable never change; retire, never delete) and the seed live in SQL.
/// No app or readonly privilege: read through database functions only (B1).
model Permission {
  identifier  String   @id
  /// merchant | platform
  scope       String
  grantable   Boolean
  /// What the permission allows, in the owner-approved wording (P5.6, O13); required for merchant permissions (CHECK)
  description String?
  /// active | retired
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  platformGrants  PlatformMembershipGrant[]

  @@map("permission_catalog")
  @@schema("identity")
}

/// P5.1 (ADR-16, D4/A3): a platform staff member's own grants. Only active, grantable platform permissions (trigger in
/// SQL). No app or readonly privilege; written by identity.set_platform_grants from P5.7.
model PlatformMembershipGrant {
  platformMembershipId String   @map("platform_membership_id") @db.Uuid
  permission           String
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  platformMembership PlatformMembership @relation(fields: [platformMembershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  catalogEntry       Permission         @relation(fields: [permission], references: [identifier], onDelete: Restrict, onUpdate: Restrict)

  @@id([platformMembershipId, permission])
  @@map("platform_membership_grants")
  @@schema("identity")
}

/// One login (a refresh-token family), bound to exactly one audience and one membership (§3.1, D5).
model Session {
  id                   String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  identityId           String    @map("identity_id") @db.Uuid
  audience             String
  platformMembershipId String?   @map("platform_membership_id") @db.Uuid
  merchantMembershipId String?   @map("merchant_membership_id") @db.Uuid
  /// The customer audience (P7): the customer record the session signs in as.
  customerId           String?   @map("customer_id") @db.Uuid
  /// "full", or "mfa_enrollment" for a platform login that may only enrol TOTP (D8).
  scope                String    @default("full")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  absoluteExpiresAt    DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason         String?   @map("revoke_reason")
  createdIp            String?   @map("created_ip")
  userAgent            String?   @map("user_agent")

  identity           Identity            @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  platformMembership PlatformMembership? @relation(fields: [platformMembershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  merchantMembership MerchantMembership? @relation(fields: [merchantMembershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "sessions_customer_fkey")
  refreshTokens      RefreshToken[]

  @@index([identityId])
  @@map("sessions")
  @@schema("identity")
}

/// Rotating refresh tokens of a session (§3.2). Presenting a rotated token is reuse: the session is revoked.
model RefreshToken {
  id        String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([sessionId])
  @@map("refresh_tokens")
  @@schema("identity")
}

/// Single-use email-verification and password-reset tokens (§3.2, D12).
model OneTimeToken {
  id          String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  identityId  String    @map("identity_id") @db.Uuid
  purpose     String
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  requestedIp String?   @map("requested_ip")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([identityId, purpose])
  @@map("one_time_tokens")
  @@schema("identity")
}

/// Pending second factor of a platform login (D8): 5 minutes, 5 attempts.
/// P4.2 login membership selection (ADR-15 T4): 5 minutes, single use, hash only (CHECKs in SQL).
model MembershipSelectionChallenge {
  id         String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  identityId String    @map("identity_id") @db.Uuid
  audience   String
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("membership_selection_challenges")
  @@schema("identity")
}

model MfaChallenge {
  id                   String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  identityId           String    @map("identity_id") @db.Uuid
  platformMembershipId String    @map("platform_membership_id") @db.Uuid
  tokenHash            String    @unique @map("token_hash") @db.Char(64)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts             Int       @default(0)
  consumedAt           DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  identity           Identity           @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  platformMembership PlatformMembership @relation(fields: [platformMembershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("mfa_challenges")
  @@schema("identity")
}

/// TOTP secret (RFC 6238), encrypted with AES-256-GCM by the API under key secret_key_id (D8).
model TotpCredential {
  identityId       String    @id @map("identity_id") @db.Uuid
  secretCiphertext Bytes     @map("secret_ciphertext")
  secretKeyId      String    @map("secret_key_id")
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz(6)
  /// Highest accepted TOTP time step; codes at or below it are replays.
  lastUsedStep     BigInt?   @map("last_used_step")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("totp_credentials")
  @@schema("identity")
}

/// Single-use MFA recovery codes, stored hashed (D8).
model RecoveryCode {
  id         String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  identityId String    @map("identity_id") @db.Uuid
  codeHash   String    @unique @map("code_hash") @db.Char(64)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([identityId])
  @@map("recovery_codes")
  @@schema("identity")
}

/// Merchant audience membership — the minimal P3 slice (ADR-14 D2: owners only in P3; staff/agents P4).
/// P4.3 (ADR-15 T7): tenant-owned; RLS, archive instead of delete, active name unique per merchant (SQL).
model Branch {
  id         String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId String    @map("merchant_id") @db.Uuid
  name       String
  status     String    @default("active")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant    Merchant             @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberships MerchantMembership[]
  invitations Invitation[]
  customers   Customer[]

  @@unique([merchantId, id])
  @@map("branches")
  @@schema("tenancy")
}

/// P4.3 (ADR-15 T8): merchant-defined role names; their permissions are RolePermission rows (P5.1).
model Role {
  id         String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId String    @map("merchant_id") @db.Uuid
  name       String
  status     String    @default("active")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant    Merchant             @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberships MerchantMembership[]
  invitations Invitation[]
  permissions RolePermission[]

  @@unique([merchantId, id])
  @@map("roles")
  @@schema("tenancy")
}

/// P5.1 (ADR-16): a merchant role's permissions, same tenant by composite key. Only active, grantable merchant
/// permissions (trigger in SQL); RLS in SQL. No app or readonly privilege; written by tenancy.set_role_permissions
/// from P5.6.
model RolePermission {
  merchantId String   @map("merchant_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  permission String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role         Role       @relation(fields: [merchantId, roleId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict)
  catalogEntry Permission @relation(fields: [permission], references: [identifier], onDelete: Restrict, onUpdate: Restrict)

  @@id([merchantId, roleId, permission])
  @@map("role_permissions")
  @@schema("tenancy")
}

model MerchantMembership {
  id            String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId    String    @map("merchant_id") @db.Uuid
  identityId    String    @map("identity_id") @db.Uuid
  kind          String
  status        String    @default("active")
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Staff only (CHECK in SQL): the merchant-defined role (permissions attach in P5).
  roleId        String?   @map("role_id") @db.Uuid
  /// Staff only: restricted to this branch; NULL = all branches (the default, OPEN-2).
  branchId      String?   @map("branch_id") @db.Uuid

  merchant            Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  identity            Identity     @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role                Role?        @relation(fields: [merchantId, roleId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict)
  branch              Branch?      @relation(fields: [merchantId, branchId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict)
  sessions            Session[]
  invitationsSent     Invitation[] @relation("InvitationInviter")
  invitationsAccepted Invitation[] @relation("InvitationAcceptedMembership")
  customersCreated    Customer[]   @relation("CustomerCreatedBy")
  agentAssignments    CustomerAssignment[] @relation("AssignmentAgent")
  assignmentsMade     CustomerAssignment[] @relation("AssignmentAssignedBy")
  assignmentsEnded    CustomerAssignment[] @relation("AssignmentEndedBy")
  packagesCreated     SavingsPackage[]     @relation("PackageCreatedBy")
  enrolmentsMade      SavingsEnrolment[]   @relation("EnrolmentEnrolledBy")
  agentRemittances    Remittance[]         @relation("RemittanceAgent")
  remittancesApproved Remittance[]         @relation("RemittanceApprovedBy")
  agentCollections    Collection[]         @relation("CollectionAgent")
  collectionsCancelled Collection[]        @relation("CollectionCancelledBy")
  savingsMovementsMade SavingsMovement[]
  targetGoalsSet      TargetGoal[]
  receiptsClassified  PaymentReceipt[]     @relation("ReceiptClassifiedBy")

  @@unique([merchantId, id])
  @@unique([merchantId, identityId])
  /// P5.7: one business's members, newest first, for the platform team (chosen from recorded query plans)
  @@index([merchantId, createdAt, id], map: "merchant_memberships_merchant_id_created_at_id_idx")
  @@map("merchant_memberships")
  @@schema("tenancy")
}

// ── customers ───────────────────────────────────────────────────────────────────────────────────

/// A business's customer (P7; the owner's answers of 2026-10-25). Reached only through customers.* definer functions.
/// Partial unique indexes live in the migration: one customer per phone number per business among those not
/// anonymised (customers_one_per_phone), one per person per business (customers_one_per_identity).
model Customer {
  id                    String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId            String    @map("merchant_id") @db.Uuid
  branchId              String    @map("branch_id") @db.Uuid
  fullName              String    @map("full_name")
  /// Normalised (customers.normalise_phone); null only once anonymised (BR-11.3).
  phone                 String?
  email                 String?
  address               String?
  nickname              String?
  status                String    @default("active")
  /// The customer's app sign-in, once they accept the business's link.
  identityId            String?   @map("identity_id") @db.Uuid
  createdByMembershipId String?   @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deactivatedAt         DateTime? @map("deactivated_at") @db.Timestamptz(6)
  anonymisedAt          DateTime? @map("anonymised_at") @db.Timestamptz(6)

  merchant       Merchant              @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "customers_merchant_fkey")
  branch         Branch                @relation(fields: [merchantId, branchId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "customers_branch_fkey")
  identity       Identity?             @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "customers_identity_fkey")
  createdBy      MerchantMembership?   @relation("CustomerCreatedBy", fields: [merchantId, createdByMembershipId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "customers_created_by_fkey")
  assignments    CustomerAssignment[]
  appInvitations CustomerAppInvitation[]
  sessions       Session[]
  enrolments     SavingsEnrolment[]
  savingsCycles  SavingsCycle[]
  collections    Collection[]
  movements      SavingsMovement[]
  targetGoals    TargetGoal[]
  liveWallets    LiveWallet[]

  @@unique([merchantId, id], map: "customers_merchant_id_id_key")
  @@index([merchantId, branchId, createdAt, id], map: "customers_merchant_branch_idx")
  @@map("customers")
  @@schema("customers")
}

/// Every period an agent holds a customer (D1; owner Q5). At most one open per customer (assignments_one_open).
model CustomerAssignment {
  id                     String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId             String    @map("merchant_id") @db.Uuid
  customerId             String    @map("customer_id") @db.Uuid
  agentMembershipId      String    @map("agent_membership_id") @db.Uuid
  assignedAt             DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  endedAt                DateTime? @map("ended_at") @db.Timestamptz(6)
  assignedByMembershipId String?   @map("assigned_by_membership_id") @db.Uuid
  endedByMembershipId    String?   @map("ended_by_membership_id") @db.Uuid

  merchant   Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "assignments_merchant_fkey")
  customer   Customer            @relation(fields: [merchantId, customerId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "assignments_customer_fkey")
  agent      MerchantMembership  @relation("AssignmentAgent", fields: [merchantId, agentMembershipId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "assignments_agent_fkey")
  assignedBy MerchantMembership? @relation("AssignmentAssignedBy", fields: [merchantId, assignedByMembershipId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "assignments_assigned_by_fkey")
  endedBy    MerchantMembership? @relation("AssignmentEndedBy", fields: [merchantId, endedByMembershipId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "assignments_ended_by_fkey")

  @@unique([merchantId, id], map: "assignments_merchant_id_id_key")
  @@index([customerId, assignedAt, id], map: "assignments_customer_idx")
  @@map("assignments")
  @@schema("customers")
}

/// The link a business sends a customer for the mobile app (owner Q7, P7-9). One open per customer.
model CustomerAppInvitation {
  id         String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId String    @map("merchant_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  identityId String    @map("identity_id") @db.Uuid
  tokenHash  String    @unique(map: "app_invitations_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "app_invitations_merchant_fkey")
  customer Customer @relation(fields: [merchantId, customerId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "app_invitations_customer_fkey")
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "app_invitations_identity_fkey")

  @@unique([merchantId, id], map: "app_invitations_merchant_id_id_key")
  @@map("app_invitations")
  @@schema("customers")
}

// ── savings ─────────────────────────────────────────────────────────────────────────────────────

/// A savings package (P8; owner Q1, Q2; BR-6.1): fixed or flexible, with exactly one fee rule. Its terms never change
/// (P8-7). One active package per name per business (packages_one_active_name, a partial unique index in the migration).
model SavingsPackage {
  id                    String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId            String    @map("merchant_id") @db.Uuid
  name                  String
  kind                  String
  amountMinor           BigInt    @map("amount_minor")
  feeRule               String    @map("fee_rule")
  feeRateBp             Int?      @map("fee_rate_bp")
  status                String    @default("active")
  createdByMembershipId String?   @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz(6)

  merchant       Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "packages_merchant_fkey")
  createdBy      MerchantMembership? @relation("PackageCreatedBy", fields: [merchantId, createdByMembershipId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "packages_created_by_fkey")
  enrolments     SavingsEnrolment[]  @relation("EnrolmentPackage")
  nextEnrolments SavingsEnrolment[]  @relation("EnrolmentNextPackage")
  cycles         SavingsCycle[]
  collections    Collection[]

  @@unique([merchantId, id], map: "packages_merchant_id_id_key")
  @@index([merchantId, createdAt, id], map: "packages_merchant_created_idx")
  @@map("packages")
  @@schema("savings")
}

/// A customer's package (BR-5.1: one per customer), and the next cycle's when a change waits for the cycle to end (Q10).
model SavingsEnrolment {
  id                     String   @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId             String   @map("merchant_id") @db.Uuid
  customerId             String   @unique(map: "enrolments_customer_id_key") @map("customer_id") @db.Uuid
  packageId              String   @map("package_id") @db.Uuid
  nextPackageId          String?  @map("next_package_id") @db.Uuid
  enrolledByMembershipId String?  @map("enrolled_by_membership_id") @db.Uuid
  enrolledAt             DateTime @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  merchant    Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "enrolments_merchant_fkey")
  customer    Customer            @relation(fields: [merchantId, customerId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "enrolments_customer_fkey")
  package     SavingsPackage      @relation("EnrolmentPackage", fields: [merchantId, packageId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "enrolments_package_fkey")
  nextPackage SavingsPackage?     @relation("EnrolmentNextPackage", fields: [merchantId, nextPackageId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "enrolments_next_package_fkey")
  enrolledBy  MerchantMembership? @relation("EnrolmentEnrolledBy", fields: [merchantId, enrolledByMembershipId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "enrolments_enrolled_by_fkey")

  @@unique([merchantId, id], map: "enrolments_merchant_id_id_key")
  @@map("enrolments")
  @@schema("savings")
}

/// A 31-day savings cycle (BR-5.2; Q3), opened when its first contribution is approved (BR-5.6).
model SavingsCycle {
  id         String   @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  packageId  String   @map("package_id") @db.Uuid
  number     Int
  startsOn   DateTime @map("starts_on") @db.Date
  endsOn     DateTime @map("ends_on") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant    Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "cycles_merchant_fkey")
  customer    Customer       @relation(fields: [merchantId, customerId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "cycles_customer_fkey")
  package     SavingsPackage @relation(fields: [merchantId, packageId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "cycles_package_fkey")
  collections Collection[]

  @@unique([merchantId, id], map: "cycles_merchant_id_id_key")
  @@unique([customerId, number], map: "cycles_customer_number_key")
  @@map("cycles")
  @@schema("savings")
}

/// An agent's cash, approved for the collections it covers (Q5; TA-13).
model Remittance {
  id                     String   @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId             String   @map("merchant_id") @db.Uuid
  agentMembershipId      String   @map("agent_membership_id") @db.Uuid
  cashMinor              BigInt   @map("cash_minor")
  collectionCount        Int      @map("collection_count")
  feeTotalMinor          BigInt   @map("fee_total_minor")
  approvedByMembershipId String   @map("approved_by_membership_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant    Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "remittances_merchant_fkey")
  agent       MerchantMembership @relation("RemittanceAgent", fields: [merchantId, agentMembershipId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "remittances_agent_fkey")
  approvedBy  MerchantMembership @relation("RemittanceApprovedBy", fields: [merchantId, approvedByMembershipId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "remittances_approved_by_fkey")
  collections Collection[]

  @@unique([merchantId, id], map: "remittances_merchant_id_id_key")
  @@index([merchantId, createdAt, id], map: "remittances_merchant_created_idx")
  @@map("remittances")
  @@schema("savings")
}

/// A cash collection an agent records (BR-3, 5.3, 5.6): recorded, then approved in one remittance (TA-13) or cancelled
/// (Q6). The agent's key is unique per agent.
model Collection {
  id                      String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId              String    @map("merchant_id") @db.Uuid
  customerId              String    @map("customer_id") @db.Uuid
  agentMembershipId       String    @map("agent_membership_id") @db.Uuid
  packageId               String    @map("package_id") @db.Uuid
  amountMinor             BigInt    @map("amount_minor")
  days                    Int?
  collectedOn             DateTime  @map("collected_on") @db.Date
  status                  String    @default("recorded")
  idemKey                 String    @map("idem_key")
  recordedEntryId         String    @map("recorded_entry_id") @db.Uuid
  remittanceId            String?   @map("remittance_id") @db.Uuid
  cycleId                 String?   @map("cycle_id") @db.Uuid
  confirmedEntryId        String?   @map("confirmed_entry_id") @db.Uuid
  feeEntryId              String?   @map("fee_entry_id") @db.Uuid
  feeMinor                BigInt?   @map("fee_minor")
  approvedAt              DateTime? @map("approved_at") @db.Timestamptz(6)
  cancelledAt             DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledByMembershipId String?   @map("cancelled_by_membership_id") @db.Uuid
  cancelReason            String?   @map("cancel_reason")
  cancelEntryId           String?   @map("cancel_entry_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant       Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "collections_merchant_fkey")
  customer       Customer            @relation(fields: [merchantId, customerId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "collections_customer_fkey")
  agent          MerchantMembership  @relation("CollectionAgent", fields: [merchantId, agentMembershipId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "collections_agent_fkey")
  package        SavingsPackage      @relation(fields: [merchantId, packageId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "collections_package_fkey")
  remittance     Remittance?         @relation(fields: [merchantId, remittanceId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "collections_remittance_fkey")
  cycle          SavingsCycle?       @relation(fields: [merchantId, cycleId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "collections_cycle_fkey")
  cancelledBy    MerchantMembership? @relation("CollectionCancelledBy", fields: [merchantId, cancelledByMembershipId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "collections_cancelled_by_fkey")
  recordedEntry  JournalEntry        @relation("CollectionRecordedEntry", fields: [merchantId, recordedEntryId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "collections_recorded_entry_fkey")
  confirmedEntry JournalEntry?       @relation("CollectionConfirmedEntry", fields: [merchantId, confirmedEntryId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "collections_confirmed_entry_fkey")
  feeEntry       JournalEntry?       @relation("CollectionFeeEntry", fields: [merchantId, feeEntryId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "collections_fee_entry_fkey")
  cancelEntry    JournalEntry?       @relation("CollectionCancelEntry", fields: [merchantId, cancelEntryId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "collections_cancel_entry_fkey")

  @@unique([merchantId, id], map: "collections_merchant_id_id_key")
  @@unique([merchantId, agentMembershipId, idemKey], map: "collections_agent_key")
  @@index([merchantId, createdAt, id], map: "collections_merchant_created_idx")
  @@index([customerId, createdAt, id], map: "collections_customer_idx")
  @@index([merchantId, agentMembershipId, status, createdAt, id], map: "collections_agent_status_idx")
  @@map("collections")
  @@schema("savings")
}

/// A withdrawal to cash from savings or target savings, or a move into target savings (BR-7; Q8, Q9). The staff
/// member's key is unique per staff member.
model SavingsMovement {
  id                 String   @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId         String   @map("merchant_id") @db.Uuid
  customerId         String   @map("customer_id") @db.Uuid
  kind               String
  amountMinor        BigInt   @map("amount_minor")
  entryId            String   @map("entry_id") @db.Uuid
  madeByMembershipId String   @map("made_by_membership_id") @db.Uuid
  idemKey            String   @map("idem_key")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "movements_merchant_fkey")
  customer Customer           @relation(fields: [merchantId, customerId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "movements_customer_fkey")
  madeBy   MerchantMembership @relation(fields: [merchantId, madeByMembershipId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "movements_made_by_fkey")
  entry    JournalEntry       @relation(fields: [merchantId, entryId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "movements_entry_fkey")

  @@unique([merchantId, id], map: "movements_merchant_id_id_key")
  @@unique([merchantId, madeByMembershipId, idemKey], map: "movements_actor_key")
  @@index([customerId, createdAt, id], map: "movements_customer_idx")
  @@map("movements")
  @@schema("savings")
}

/// A customer's optional target-savings goal (Q9): an amount and/or a date.
model TargetGoal {
  id                String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId        String    @map("merchant_id") @db.Uuid
  customerId        String    @unique(map: "target_goals_customer_id_key") @map("customer_id") @db.Uuid
  goalAmountMinor   BigInt?   @map("goal_amount_minor")
  goalDate          DateTime? @map("goal_date") @db.Date
  setByMembershipId String    @map("set_by_membership_id") @db.Uuid
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  merchant Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "target_goals_merchant_fkey")
  customer Customer           @relation(fields: [merchantId, customerId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "target_goals_customer_fkey")
  setBy    MerchantMembership @relation(fields: [merchantId, setByMembershipId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "target_goals_set_by_fkey")

  @@unique([merchantId, id], map: "target_goals_merchant_id_id_key")
  @@map("target_goals")
  @@schema("savings")
}

// ── payments ────────────────────────────────────────────────────────────────────────────────────

/// A Live wallet (P9; BR-2.3, 4.1–4.3): a business's, the platform's, or a customer's (switched off until OPEN-12), and
/// its provider account. Partial unique indexes live in the migration: one per business, customer and platform, one
/// wallet per provider account number.
model LiveWallet {
  id            String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  ownerKind     String    @map("owner_kind")
  merchantId    String?   @map("merchant_id") @db.Uuid
  customerId    String?   @map("customer_id") @db.Uuid
  provider      String
  alias         String
  status        String    @default("provisioning")
  providerRef   String?   @map("provider_ref")
  accountNumber String?   @map("account_number")
  accountName   String?   @map("account_name")
  bankName      String?   @map("bank_name")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz(6)
  leaseToken    String?   @map("lease_token") @db.Uuid
  lastError     String?   @map("last_error")
  requestedBy   String?   @map("requested_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  activatedAt   DateTime? @map("activated_at") @db.Timestamptz(6)

  merchant     Merchant?             @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "live_wallets_merchant_fkey")
  customer     Customer?             @relation(fields: [merchantId, customerId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "live_wallets_customer_fkey")
  requester    Identity?             @relation("LiveWalletRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "live_wallets_requested_by_fkey")
  transactions ProviderTransaction[]
  receipts     PaymentReceipt[]
  ordersFrom   PaymentOrder[]        @relation("PaymentOrderFrom")
  ordersTo     PaymentOrder[]        @relation("PaymentOrderTo")
  findings     ReconciliationFinding[]

  @@unique([merchantId, id], map: "live_wallets_merchant_id_id_key")
  @@unique([provider, alias], map: "live_wallets_alias_key")
  @@index([createdAt, id], map: "live_wallets_created_idx")
  @@map("live_wallets")
  @@schema("payments")
}

/// A provider's notification exactly as received (TA-8): never trusted, confirmed with the provider by the worker.
model ProviderEvent {
  id          String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  provider    String
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  headers     Json
  body        String
  reference   String?
  status      String    @default("received")
  attempts    Int       @default(0)
  nextCheckAt DateTime  @default(now()) @map("next_check_at") @db.Timestamptz(6)
  leaseUntil  DateTime? @map("lease_until") @db.Timestamptz(6)
  leaseToken  String?   @map("lease_token") @db.Uuid
  outcome     String?
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@map("provider_events")
  @@schema("payments")
}

/// A provider transaction acted on, once (TA-8): what the provider confirmed and what was done with it.
model ProviderTransaction {
  id             String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  provider       String
  providerTxId   String    @map("provider_tx_id")
  walletId       String?   @map("wallet_id") @db.Uuid
  accountNumber  String?   @map("account_number")
  amountMinor    BigInt    @map("amount_minor")
  currency       String
  providerStatus String    @map("provider_status")
  matched        String
  occurredAt     DateTime? @map("occurred_at") @db.Timestamptz(6)
  confirmedAt    DateTime  @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  entryId        String?   @map("entry_id") @db.Uuid
  resolution     String?
  resolutionNote String?   @map("resolution_note")
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)

  wallet   LiveWallet?     @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "provider_transactions_wallet_fkey")
  entry    JournalEntry?   @relation(fields: [entryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "provider_transactions_entry_fkey")
  resolver Identity?       @relation("ProviderTransactionResolvedBy", fields: [resolvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "provider_transactions_resolved_by_fkey")
  receipt  PaymentReceipt?

  @@unique([provider, providerTxId], map: "provider_transactions_once")
  @@map("provider_transactions")
  @@schema("payments")
}

/// Money credited to a business's Live wallet, to be classified (Q1).
model PaymentReceipt {
  id                  String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId          String    @map("merchant_id") @db.Uuid
  walletId            String    @map("wallet_id") @db.Uuid
  transactionId       String    @unique(map: "receipts_transaction_key") @map("transaction_id") @db.Uuid
  amountMinor         BigInt    @map("amount_minor")
  receivedEntryId     String    @map("received_entry_id") @db.Uuid
  classifiedAccountId String?   @map("classified_account_id") @db.Uuid
  classifiedEntryId   String?   @map("classified_entry_id") @db.Uuid
  classifiedNote      String?   @map("classified_note")
  classifiedBy        String?   @map("classified_by") @db.Uuid
  classifiedAt        DateTime? @map("classified_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant        Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "receipts_merchant_fkey")
  wallet          LiveWallet          @relation(fields: [merchantId, walletId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "receipts_wallet_fkey")
  transaction     ProviderTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "receipts_transaction_fkey")
  receivedEntry   JournalEntry        @relation("ReceiptReceivedEntry", fields: [merchantId, receivedEntryId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "receipts_received_entry_fkey")
  classifiedEntry JournalEntry?       @relation("ReceiptClassifiedEntry", fields: [merchantId, classifiedEntryId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "receipts_classified_entry_fkey")
  classifier      MerchantMembership? @relation("ReceiptClassifiedBy", fields: [merchantId, classifiedBy], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "receipts_classified_by_fkey")

  @@unique([merchantId, id], map: "receipts_merchant_id_id_key")
  @@index([merchantId, createdAt, id], map: "receipts_merchant_created_idx")
  @@map("receipts")
  @@schema("payments")
}

/// Money leaving a wallet (TA-8), with the 'unknown' state a timeout leaves it in. Machinery in P9 (Q2); first used by
/// billing (P10).
model PaymentOrder {
  id              String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  fromWalletId    String    @map("from_wallet_id") @db.Uuid
  toWalletId      String?   @map("to_wallet_id") @db.Uuid
  toBank          Json?     @map("to_bank")
  amountMinor     BigInt    @map("amount_minor")
  reference       String    @unique(map: "payment_orders_reference_key")
  purpose         String
  ledgerId        String    @map("ledger_id") @db.Uuid
  postingTemplate String    @map("posting_template")
  postingSubjects Json      @default("{}") @map("posting_subjects")
  state           String    @default("created")
  providerRef     String?   @map("provider_ref")
  providerTxId    String?   @map("provider_tx_id")
  attempts        Int       @default(0)
  nextCheckAt     DateTime  @default(now()) @map("next_check_at") @db.Timestamptz(6)
  leaseUntil      DateTime? @map("lease_until") @db.Timestamptz(6)
  leaseToken      String?   @map("lease_token") @db.Uuid
  lastError       String?   @map("last_error")
  entryId         String?   @map("entry_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)

  fromWallet LiveWallet    @relation("PaymentOrderFrom", fields: [fromWalletId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payment_orders_from_fkey")
  toWallet   LiveWallet?   @relation("PaymentOrderTo", fields: [toWalletId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payment_orders_to_fkey")
  ledger     Ledger        @relation(fields: [ledgerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payment_orders_ledger_fkey")
  entry      JournalEntry? @relation("PaymentOrderEntry", fields: [entryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payment_orders_entry_fkey")

  @@map("payment_orders")
  @@schema("payments")
}

/// A difference between the books and the provider, kept for the platform team until a person resolves it (Q5). One open
/// per scope and wallet (reconciliation_findings_one_open, in the migration).
model ReconciliationFinding {
  id                   String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  scope                String
  walletId             String?   @map("wallet_id") @db.Uuid
  providerBalanceMinor BigInt    @map("provider_balance_minor")
  booksBalanceMinor    BigInt    @map("books_balance_minor")
  status               String    @default("open")
  foundAt              DateTime  @default(now()) @map("found_at") @db.Timestamptz(6)
  lastSeenAt           DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  resolutionNote       String?   @map("resolution_note")
  resolvedBy           String?   @map("resolved_by") @db.Uuid
  resolvedAt           DateTime? @map("resolved_at") @db.Timestamptz(6)

  wallet   LiveWallet? @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "reconciliation_findings_wallet_fkey")
  resolver Identity?   @relation("FindingResolvedBy", fields: [resolvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "reconciliation_findings_resolved_by_fkey")

  @@index([foundAt, id], map: "reconciliation_findings_found_idx")
  @@map("reconciliation_findings")
  @@schema("payments")
}

// ── util ────────────────────────────────────────────────────────────────────────────────────────

/// Fixed-window rate-limit counters (ADR-14 D13), reached only through util.rate_limit_hit().
model RateLimitCounter {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  hits        Int      @default(0)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_counters")
  @@schema("util")
}

/// A command's idempotency key (P6, TA-6): claimed in its own transaction (util.claim_idempotency), locked first and
/// completed with its response by the command's function, released when the command is refused. Reached only through
/// those functions.
model IdempotencyRecord {
  id          String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId  String    @map("merchant_id") @db.Uuid
  identityId  String    @map("identity_id") @db.Uuid
  operation   String
  idemKey     String    @map("idem_key")
  fingerprint String
  state       String    @default("in_progress")
  response    Json?
  claimedAt   DateTime  @default(now()) @map("claimed_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "idempotency_records_merchant_fkey")
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "idempotency_records_identity_fkey")

  @@unique([merchantId, id], map: "idempotency_records_merchant_id_id_key")
  @@unique([merchantId, identityId, operation, idemKey], map: "idempotency_records_scope_key")
  @@map("idempotency_records")
  @@schema("util")
}

/// The containment switch (P5 plan §11.1, P5.5): exactly one row (the CHECK on id lives in SQL). While a flag is set,
/// the resolver and every write-time re-check ignore grant rows of that kind. Changed only by the operator function
/// util.set_authorization_containment, which records #39; no app or reporting grant.
model AuthorizationContainment {
  id                      Boolean  @id @default(true)
  merchantGrantsSuspended Boolean  @default(false) @map("merchant_grants_suspended")
  platformGrantsSuspended Boolean  @default(false) @map("platform_grants_suspended")
  updatedAt               DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("authorization_containment")
  @@schema("util")
}

/// P4.6 (ADR-15 T10, T11): an invitation until accepted — no membership exists before. Single use, expiring,
/// revocable; the token is stored hashed and the app cannot read it. Written only by SECURITY DEFINER functions.
/// Partial unique index (one open invitation per business and email) and CHECKs live in SQL.
model Invitation {
  id                    String    @id @default(dbgenerated("util.uuid_v7()")) @db.Uuid
  merchantId            String    @map("merchant_id") @db.Uuid
  email                 String
  /// staff | agent
  kind                  String
  roleId                String?   @map("role_id") @db.Uuid
  branchId              String?   @map("branch_id") @db.Uuid
  identityId            String    @map("identity_id") @db.Uuid
  invitedByMembershipId String    @map("invited_by_membership_id") @db.Uuid
  tokenHash             String    @unique @map("token_hash") @db.Char(64)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt            DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedMembershipId  String?   @map("accepted_membership_id") @db.Uuid
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant           Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role               Role?               @relation(fields: [merchantId, roleId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict)
  branch             Branch?             @relation(fields: [merchantId, branchId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict)
  identity           Identity            @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitedBy          MerchantMembership  @relation("InvitationInviter", fields: [merchantId, invitedByMembershipId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invitations_merchant_id_invited_by_fkey")
  acceptedMembership MerchantMembership? @relation("InvitationAcceptedMembership", fields: [merchantId, acceptedMembershipId], references: [merchantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invitations_merchant_id_accepted_membership_fkey")

  @@unique([merchantId, id])
  @@index([identityId])
  /// P5.8 (O9): every invitation of a business, newest first (chosen from recorded query plans); the pending ones
  /// have a partial index of their own, which this schema does not express
  @@index([merchantId, createdAt, id], map: "invitations_merchant_id_created_at_id_idx")
  @@map("invitations")
  @@schema("tenancy")
}
