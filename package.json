{
  "name": "alphakolect",
  "private": true,
  "description": "AlphaKolect rebuild workspace (see docs/architecture/TARGET_ARCHITECTURE.md). The legacy app lives in legacy/ and is not part of the workspace.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:concurrency": "pnpm --filter @alphakolect/db run test:concurrency",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "type": "module",
  "prettier": "@alphakolect/config/prettier",
  "devDependencies": {
    "@alphakolect/config": "workspace:*",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
