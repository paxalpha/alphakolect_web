# AlphaKolect workspace ignores.
# legacy/current-system/ has its own .gitignore for the quarantined app.

# dependencies & build output
node_modules/
dist/
build/
out/
.next/
coverage/
*.tsbuildinfo
next-env.d.ts
.turbo/
.pnpm-store/

# env files — never commit real values; only *.example templates are tracked
.env
.env.*
!.env.example
!**/.env.example

# secrets, archives, dumps
*.pem
*.key
*.p12
*.pfx
*.tar.gz
*.gz
*.zip
*.sql.gz
*.dump
*.backup

# logs & local tooling
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# uploads and user files never live in git
uploads/

# legacy guard (kept from repo creation)
*.py
.mypy_cache/
__pycache__/
AUDIT_REPORT.md
