# Copy to infrastructure/.env (gitignored) and set local-only passwords (at least 16 characters each).
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# PostgreSQL superuser (local administration, bootstrap, and the db test harness only).
POSTGRES_PASSWORD=<local-password>

# Application roles created by packages/db/sql/bootstrap on first start.
DB_MIGRATOR_PASSWORD=<local-password>
DB_APP_PASSWORD=<local-password>
DB_WORKER_PASSWORD=<local-password>
DB_READONLY_PASSWORD=<local-password>
