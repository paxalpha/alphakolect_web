# AlphaKolect API — environment template (names and safe local placeholders only).
# Copy to apps/api/.env for local development. Never commit real values.
# The API validates these at startup and refuses to boot if a required one is missing or invalid.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Required. The API connects as the least-privilege app role (never the superuser or the migrator),
# to the local PostgreSQL from infrastructure/compose.yaml (NOT the legacy recovery DB).
# Password: DB_APP_PASSWORD from infrastructure/.env.
DATABASE_URL=postgresql://alphakolect_app:<DB_APP_PASSWORD>@127.0.0.1:5436/alphakolect

# Access-token signing (ADR-14 D6): an Ed25519 private JWK with a kid, as single-line JSON. Required.
# The previous key (optional) keeps verifying tokens during a rotation.
AUTH_SIGNING_JWK=<generate with: pnpm --filter @alphakolect/api secrets:local>
# AUTH_SIGNING_JWK_PREVIOUS=
# AUTH_ISSUER=alphakolect-api

# MFA secret encryption at rest (ADR-14 D8): "<kid>:<base64 of 32 random bytes>". Required.
MFA_ENCRYPTION_KEY=<generate with: pnpm --filter @alphakolect/api secrets:local>
# MFA_ENCRYPTION_KEY_PREVIOUS=

# Web origins allowed to make cookie-authenticated state changes (CSRF defence, ADR-14 D7). Comma-separated.
# Empty = none. Local web app (P13) would be e.g. http://localhost:3000.
WEB_ORIGINS=

# Production: COOKIE_DOMAIN=.alphakolect.com (unset locally = host-only cookies).
# COOKIE_DOMAIN=
# Outgoing email (ADR-14 D1). Required in production; locally they default to Mailpit
# (docker compose -f infrastructure/compose.yaml up -d mailpit; inbox at http://127.0.0.1:8025).
# SMTP_URL may contain credentials: keep it out of version control.
# SMTP_URL=smtp://127.0.0.1:1025
# MAIL_FROM=AlphaKolect <no-reply@alphakolect.local>
# Origin of the web app that serves links in emails. Required in production.
# WEB_APP_URL=http://localhost:3000

# Reverse proxies whose X-Forwarded-For is trusted for the client IP (rate limits, audit), by address only:
# "false", or comma-separated "loopback", IPs and CIDR subnets (default loopback = nginx on this host).
# Hop counts are not accepted. Production: the API listener must not be reachable except through the proxy.
# TRUST_PROXY=loopback

# Payments (P9). The provider the API and the worker use; production requires transactpay and its keys. Keep the keys out
# of version control. Customer Live wallets stay false in production until custody is settled in writing (OPEN-12).
# PAYMENT_PROVIDER=fake
# TRANSACTPAY_BASE_URL=https://payment-api-service.transactpay.ai
# TRANSACTPAY_PUBLIC_KEY=
# TRANSACTPAY_SECRET_KEY=
# TRANSACTPAY_ENCRYPTION_KEY_BASE64=
# CUSTOMER_LIVE_WALLETS=false
