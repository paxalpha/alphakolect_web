# AlphaKolect API — environment template (names and safe local placeholders only).
# Copy to apps/api/.env for local development. Never commit real values.
# The API validates these at startup and refuses to boot if a required one is missing or invalid.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Required. Local PostgreSQL from infrastructure/compose.yaml (NOT the legacy recovery DB).
DATABASE_URL=postgresql://alphakolect:<local-password>@127.0.0.1:5436/alphakolect
