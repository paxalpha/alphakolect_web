{
  "name": "@alphakolect/api",
  "version": "0.0.0",
  "private": true,
  "description": "AlphaKolect API (modular monolith, TARGET_ARCHITECTURE ADR-1)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --conditions=@alphakolect/source --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "typecheck": "pnpm --filter @alphakolect/contracts client:generate && tsc --noEmit",
    "test": "pnpm --filter @alphakolect/contracts client:generate && vitest run",
    "secrets:local": "tsx scripts/generate-local-secrets.ts",
    "admin:bootstrap": "tsx --conditions=@alphakolect/source --env-file-if-exists=.env scripts/bootstrap-super-admin.ts",
    "admin:containment": "tsx --conditions=@alphakolect/source --env-file-if-exists=.env scripts/containment.ts",
    "audit:purge": "tsx --conditions=@alphakolect/source --env-file-if-exists=.env scripts/audit-purge.ts run",
    "audit:purge-request-report": "tsx --conditions=@alphakolect/source --env-file-if-exists=.env scripts/audit-purge.ts request-report",
    "audit:purge-request-cancel": "tsx --conditions=@alphakolect/source --env-file-if-exists=.env scripts/audit-purge.ts request-cancel",
    "audit:purge-reports": "tsx --conditions=@alphakolect/source --env-file-if-exists=.env scripts/audit-purge.ts reports",
    "audit:purge-export-discarded": "tsx --conditions=@alphakolect/source --env-file-if-exists=.env scripts/audit-purge.ts export-discarded",
    "audit:purge-report-handover": "tsx --conditions=@alphakolect/source --env-file-if-exists=.env scripts/audit-purge.ts report-handover",
    "audit:purge-report-handover-abandoned": "tsx --conditions=@alphakolect/source --env-file-if-exists=.env scripts/audit-purge.ts handover-abandoned",
    "audit:purge-report-delivered": "tsx --conditions=@alphakolect/source --env-file-if-exists=.env scripts/audit-purge.ts report-delivered",
    "audit:purge-report-destroyed": "tsx --conditions=@alphakolect/source --env-file-if-exists=.env scripts/audit-purge.ts report-destroyed",
    "audit:purge-report-lost": "tsx --conditions=@alphakolect/source --env-file-if-exists=.env scripts/audit-purge.ts report-lost"
  },
  "dependencies": {
    "@alphakolect/contracts": "workspace:*",
    "express": "^5.2.1",
    "hash-wasm": "4.12.0",
    "jose": "6.2.12",
    "nodemailer": "10.0.13",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@alphakolect/config": "workspace:*",
    "@alphakolect/db": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
