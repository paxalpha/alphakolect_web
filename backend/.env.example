# AlphaKolect backend — environment template.
# Copy to backend/.env for local development. NEVER commit real values; backend/.env is gitignored.
# Every variable the backend reads is listed here. Values below are safe local placeholders.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Use EITHER DATABASE_URL OR the DB_* variables. Nothing is hardcoded in code;
# the backend refuses to start if neither is set.
# DATABASE_URL=postgresql://<user>:<password>@localhost:5435/alphacollect_db
DB_HOST=localhost
DB_PORT=5435
DB_NAME=alphacollect_db
DB_USER=alphakolect_recovery
DB_PASSWORD=<set-locally>
# TLS to the database is used only when DB_SSL=true.
DB_SSL=false

# ── Auth ──────────────────────────────────────────────────────────────────────
# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`).
JWT_SECRET=<generate-a-long-random-secret>

# ── Super Admin password recovery ─────────────────────────────────────────────
# Base URL of the web app; reset links are sent as ${ADMIN_APP_URL}/admin/reset-password?token=…
ADMIN_APP_URL=http://localhost:3000

# ── Email (nodemailer SMTP) ───────────────────────────────────────────────────
# Local: Mailpit (docker run -d --name alphakolect-mailpit -p 127.0.0.1:1025:1025 -p 127.0.0.1:8025:8025 axllent/mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Leave EMAIL_USER/EMAIL_PASS empty for an unauthenticated relay (Mailpit, local Exim).
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@alphakolect.com
# true = do not send any email (merchant/collaborator OTP and super-admin reset emails are skipped).
EMAIL_DISABLED=false

# ── Merchant / collaborator OTP (legacy; see RESTRUCTURING_MAP SEC-8) ─────────
# Leave OTP_MASTER empty. A master OTP bypasses verification and must never be set in production.
OTP_MASTER=
OTP_SKIP_EXPIRY=false
OTP_GRACE_MS=120000

# ── TransactPay (use sandbox keys outside production) ─────────────────────────
TRANSACTPAY_PUBLIC_KEY=<sandbox-public-key>
TRANSACTPAY_SECRET_KEY=<sandbox-secret-key>
TRANSACTPAY_ENCRYPTION_KEY_BASE64=<sandbox-encryption-key-base64>
