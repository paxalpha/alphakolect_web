{
  "name": "@alphakolect/db",
  "version": "0.0.0",
  "private": true,
  "description": "Database infrastructure only: Prisma schema, migrations, RLS/trigger/grant SQL, test fixtures (RESTRUCTURING_MAP §1)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": {
      "@alphakolect/source": "./test/support/setup-db.ts"
    },
    "./lock-analysis": {
      "@alphakolect/source": "./test/support/lock-analysis.ts"
    },
    "./lock-plan": {
      "@alphakolect/source": "./test/support/lock-plan.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json --noEmit",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "test": "prisma generate && vitest run",
    "test:concurrency": "prisma generate && vitest run --config vitest.concurrency.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@alphakolect/config": "workspace:*",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
