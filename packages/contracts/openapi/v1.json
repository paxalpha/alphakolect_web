{
  "openapi": "3.1.0",
  "info": {
    "title": "AlphaKolect API",
    "version": "v1",
    "description": "Generated from packages/contracts — do not edit by hand. Money amounts are kobo as exact decimal digit strings (e.g. \"150000\" = ₦1,500.00)."
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness check",
        "tags": [
          "public"
        ],
        "x-audience": "public",
        "responses": {
          "200": {
            "description": "The API process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error (standard error envelope)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Sign in with email and password",
        "tags": [
          "public"
        ],
        "x-audience": "public",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in, or a second step is required",
            "headers": {
              "Set-Cookie": {
                "required": true,
                "description": "Session cookies: __Secure-ak_at, __Secure-ak_rt and __Secure-ak_csrf (HttpOnly except the CSRF cookie)",
                "schema": {
                  "type": "string",
                  "description": "Session cookies: __Secure-ak_at, __Secure-ak_rt and __Secure-ak_csrf (HttpOnly except the CSRF cookie)"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS — identical for unknown accounts and wrong passwords",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "EMAIL_VERIFICATION_REQUIRED — only after correct credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "string",
                  "description": "Seconds to wait before retrying"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error (standard error envelope)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "summary": "Rotate the session (refresh cookie; send the X-CSRF-Token header)",
        "tags": [
          "public"
        ],
        "x-audience": "public",
        "responses": {
          "200": {
            "description": "New session cookies",
            "headers": {
              "Set-Cookie": {
                "required": true,
                "description": "Session cookies: __Secure-ak_at, __Secure-ak_rt and __Secure-ak_csrf (HttpOnly except the CSRF cookie)",
                "schema": {
                  "type": "string",
                  "description": "Session cookies: __Secure-ak_at, __Secure-ak_rt and __Secure-ak_csrf (HttpOnly except the CSRF cookie)"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_OR_EXPIRED_TOKEN — the session cookies are cleared",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "CSRF_FAILED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "headers": {
              "Retry-After": {
                "required": true,
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "string",
                  "description": "Seconds to wait before retrying"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error (standard error envelope)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "End the current session",
        "tags": [
          "authenticated"
        ],
        "x-audience": "authenticated",
        "x-session-scope": "mfa_enrollment",
        "security": [
          {
            "cookieSession": [],
            "csrfToken": []
          },
          {
            "bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out; session cookies cleared",
            "headers": {
              "Set-Cookie": {
                "required": true,
                "description": "Session cookies: __Secure-ak_at, __Secure-ak_rt and __Secure-ak_csrf (HttpOnly except the CSRF cookie)",
                "schema": {
                  "type": "string",
                  "description": "Session cookies: __Secure-ak_at, __Secure-ak_rt and __Secure-ak_csrf (HttpOnly except the CSRF cookie)"
                }
              }
            }
          },
          "default": {
            "description": "Error (standard error envelope)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/session": {
      "get": {
        "operationId": "getSession",
        "summary": "The current session",
        "tags": [
          "authenticated"
        ],
        "x-audience": "authenticated",
        "x-session-scope": "mfa_enrollment",
        "security": [
          {
            "cookieSession": []
          },
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "The current session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Error (standard error envelope)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "$ref": "#/components/schemas/Email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "audience": {
            "$ref": "#/components/schemas/WebAudience"
          }
        },
        "required": [
          "email",
          "password",
          "audience"
        ]
      },
      "Email": {
        "type": "string",
        "maxLength": 254,
        "format": "email",
        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
        "example": "owner@example.com"
      },
      "WebAudience": {
        "type": "string",
        "enum": [
          "platform",
          "merchant"
        ]
      },
      "AmountMinor": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,18})$",
        "description": "Non-negative amount in minor units (kobo) as a decimal digit string",
        "example": "150000"
      },
      "Currency": {
        "type": "string",
        "const": "NGN",
        "description": "ISO 4217 currency code. Only NGN is accepted."
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string",
                "description": "Human-readable; never contains secrets"
              },
              "details": {},
              "requestId": {
                "type": "string",
                "description": "Echoed in the x-request-id response header"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "description": "Every error response uses this envelope"
      },
      "ErrorCode": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "example": "NOT_FOUND"
      },
      "LoginResponse": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "authenticated"
              },
              "session": {
                "$ref": "#/components/schemas/Session"
              }
            },
            "required": [
              "status",
              "session"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "mfa_enrollment_required"
              },
              "session": {
                "$ref": "#/components/schemas/Session"
              }
            },
            "required": [
              "status",
              "session"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "mfa_required"
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          }
        ],
        "type": "object"
      },
      "Session": {
        "type": "object",
        "properties": {
          "identityId": {
            "$ref": "#/components/schemas/Id"
          },
          "audience": {
            "$ref": "#/components/schemas/SessionAudience"
          },
          "membershipId": {
            "$ref": "#/components/schemas/Id"
          },
          "merchantId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "full",
              "mfa_enrollment"
            ]
          }
        },
        "required": [
          "identityId",
          "audience",
          "membershipId",
          "merchantId",
          "scope"
        ],
        "additionalProperties": false,
        "description": "The signed-in session (no tokens: those are in HttpOnly cookies)"
      },
      "SessionAudience": {
        "type": "string",
        "enum": [
          "platform",
          "merchant",
          "agent"
        ]
      },
      "Id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
        "description": "UUIDv7 identifier",
        "example": "01900000-0000-7000-8000-00000000000a"
      },
      "Money": {
        "type": "object",
        "properties": {
          "amountMinor": {
            "$ref": "#/components/schemas/AmountMinor"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          }
        },
        "required": [
          "amountMinor",
          "currency"
        ],
        "additionalProperties": false,
        "description": "An amount of money",
        "example": {
          "amountMinor": "150000",
          "currency": "NGN"
        }
      }
    },
    "securitySchemes": {
      "cookieSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-ak_at",
        "description": "Web audiences (platform, merchant): HttpOnly access-token cookie (ADR-14 D7)"
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Echo of the __Secure-ak_csrf cookie, required on state-changing cookie requests"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Mobile audiences (agent, customer): EdDSA-signed access token (ADR-14 D6)"
      }
    }
  }
}
